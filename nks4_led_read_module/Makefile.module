# ONE-SHOT diagnostic module - not embedded in the daemon, just insmod'd
# directly during investigation. Never patches any code - only calls two
# pre-existing driver functions through normal (regparm) function pointers.
# See nks4_led_read.c's own header comment for the full technique,
# provenance, and the collision-risk discussion.
KDIR ?= /home/build/linux-kronos
PWD  := $(shell pwd)

all:
	$(MAKE) -C $(KDIR) M=$(PWD) modules

clean:
	$(MAKE) -C $(KDIR) M=$(PWD) clean
