# screenremote configuration
# Copy this file to /korg/rw/screenremote/screenremote.cfg on the Kronos and edit as needed.
# The /korg/rw/screenremote/ directory is created automatically by the daemon on first run.
# Changes take effect the next time screenremote starts (reboot, or rmmod/insmod).
#
# Lines beginning with # are comments and are ignored.
# Recognised keys: stream_port, ctrl_port, screensaver_timeout, stream_max_kbps, stream_height,
#   touch_x_offset, touch_x_range, touch_y_offset, touch_y_range
#
# Default values are shown below (commented out).
# Uncomment and change a line to override the default.

#stream_port=7373
#ctrl_port=7374

# screensaver_timeout: seconds of no fb1 change before VGA output is blanked.
# Set to 0 to disable. Default is 300 (5 minutes).
# Only affects fb0 (VGA mirror) — the Kronos display (fb1) is never touched.
#screensaver_timeout=300

# Touch calibration: adjusts the pixel-to-ADC mapping for touchscreen injection.
# The values below are the Kronos defaults. On a Nautilus the daemon substitutes
# hardware-calibrated values automatically: touch_x_range=857, touch_x_offset=24,
# touch_y_range=570, touch_y_offset=29. Setting any one of these keys here
# suppresses that one substitution, so only do so if remote touch events land at
# the wrong position on THIS unit.
#touch_x_offset=10
#touch_x_range=813
#touch_y_offset=20
#touch_y_range=638

# Native (v3) stream tuning - see docs/api.md section 4.5.
# stream_max_kbps: byte-rate cap for v3 clients, kilobits per second. Default is
# 24000 on Nautilus (its USB2 ethernet shares the USB bus with the front panel)
# and 0 (unlimited) on Kronos. 0 disables the cap.
#stream_max_kbps=24000
# stream_height: visible rows to stream. Default: the framebuffer height, except
# on Nautilus where the physical panel is 800x480 inside an 800x600 buffer.
#stream_height=480
# cpu_affinity: bitmask of CPUs the daemon (and its children) may run on, e.g.
# 0x8 = CPU3, 0x3 = CPUs 0+1. Default: derived from /proc/rtai/scheduler so the
# daemon stays off the cores running OA's real-time tasks (see pick_cpu_affinity()).
#cpu_affinity=0x8
